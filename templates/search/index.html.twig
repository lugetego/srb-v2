{% extends 'base.html.twig' %}

{% block title %}Búsqueda avanzada — SRB{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap">
<style>
:root {
    --srb-border:  #e0e2e6;
    --srb-borderl: #eceef1;
    --srb-t1:      #1a1a1a;
    --srb-t2:      #555555;
    --srb-t3:      #999999;
    --srb-accent:  #1b4fa8;
    --srb-accent2: #144090;
    --srb-accbg:   #e8f0fb;
    --srb-green:   #1a6e46;
}

body { font-family: 'Source Sans 3', system-ui, sans-serif; background: #fff; color: var(--srb-t1); }

/* ── Page ── */
.srb-page { max-width: 860px; }

/* ── Page header ── */
.srb-page-header { padding: 24px 0 20px; border-bottom: 1px solid var(--srb-border); margin-bottom: 24px; }
.srb-page-title {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 1.55rem; font-weight: 700; color: var(--srb-t1); margin-bottom: 3px;
}
.srb-page-desc { font-size: .9rem; color: var(--srb-t3); }

/* ── Form panel ── */
.srb-form-panel {
    background: #fff;
    border: 1px solid var(--srb-border);
    border-radius: 10px;
    padding: 20px 22px 18px;
    margin-bottom: 28px;
}

/* ── Field ── */
.srb-field { display: flex; flex-direction: column; gap: 5px; }
.srb-field label {
    font-size: .8rem; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--srb-t3);
}
.srb-field input[type="text"],
.srb-field input[type="number"] {
    padding: 9px 13px;
    border: 1.5px solid var(--srb-border);
    border-radius: 7px;
    background: #fafafa;
    color: var(--srb-t1);
    font-family: 'Source Sans 3', inherit; font-size: .9375rem;
    outline: none;
    transition: border-color .15s, box-shadow .15s, background .15s;
}
.srb-field input[type="text"]:focus,
.srb-field input[type="number"]:focus {
    border-color: var(--srb-accent);
    box-shadow: 0 0 0 3px var(--srb-accbg);
    background: #fff;
}
.srb-field input::placeholder { color: var(--srb-t3); }

/* ── Form grid rows ── */
.srb-form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.srb-form-row-1 { margin-bottom: 14px; }

/* ── Type chips ── */
.srb-chips-row { margin-bottom: 14px; }
.srb-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 5px; }
.srb-chip {
    display: inline-flex; align-items: center;
    padding: 5px 13px;
    border: 1.5px solid var(--srb-border);
    border-radius: 20px;
    font-size: .875rem; font-weight: 500; color: var(--srb-t2);
    cursor: pointer; user-select: none;
    transition: border-color .12s, background .12s, color .12s;
    background: #fafafa;
}
.srb-chip input[type="radio"] { display: none; }
.srb-chip:hover { border-color: var(--srb-accent); color: var(--srb-accent); background: var(--srb-accbg); }
.srb-chip.chip-active,
.srb-chip input[type="radio"]:checked ~ span { color: var(--srb-accent); }
.srb-chip.chip-active { background: var(--srb-accbg); border-color: var(--srb-accent); color: var(--srb-accent); font-weight: 600; }

/* ── Year row ── */
.srb-year-row { display: flex; align-items: flex-end; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
.srb-year-field { display: flex; flex-direction: column; gap: 5px; }
.srb-year-field label { font-size: .8rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--srb-t3); }
.srb-year-field input { width: 100px; }
.srb-year-sep { color: var(--srb-t3); font-size: .875rem; padding-bottom: 10px; }

/* ── All-years toggle ── */
.srb-toggle-wrap { display: flex; align-items: center; gap: 8px; padding-bottom: 9px; }
.srb-toggle { position: relative; width: 36px; height: 20px; flex-shrink: 0; }
.srb-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
.srb-toggle-track {
    position: absolute; inset: 0;
    background: #d0d4db; border-radius: 20px;
    cursor: pointer; transition: background .2s;
}
.srb-toggle input:checked + .srb-toggle-track { background: var(--srb-accent); }
.srb-toggle-track::after {
    content: '';
    position: absolute; top: 3px; left: 3px;
    width: 14px; height: 14px;
    background: #fff; border-radius: 50%;
    transition: transform .2s;
}
.srb-toggle input:checked + .srb-toggle-track::after { transform: translateX(16px); }
.srb-toggle-label { font-size: .9rem; color: var(--srb-t2); cursor: pointer; }
.srb-year-row.years-disabled .srb-year-field input { opacity: .35; pointer-events: none; }

/* ── Form actions ── */
.srb-form-actions { display: flex; align-items: center; gap: 10px; }
.srb-submit-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 22px;
    background: var(--srb-accent); color: #fff;
    border: none; border-radius: 7px;
    font-family: 'Source Sans 3', inherit; font-size: .9375rem; font-weight: 500;
    cursor: pointer; transition: background .15s;
}
.srb-submit-btn:hover { background: var(--srb-accent2); }
.srb-reset-link { font-size: .875rem; color: var(--srb-t3); text-decoration: none; }
.srb-reset-link:hover { color: var(--srb-t2); text-decoration: underline; }

/* ── Results header ── */
.srb-results-head {
    display: flex; align-items: baseline; justify-content: space-between;
    margin-bottom: 4px;
}
.srb-results-count { font-size: .9rem; color: var(--srb-t2); }
.srb-results-count strong { color: var(--srb-t1); }
.srb-section-head {
    font-size: .75rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: var(--srb-t3);
    padding-bottom: 8px; border-bottom: 2px solid var(--srb-border);
    margin-bottom: 2px;
}

/* ── Result list ── */
.srb-result-list { list-style: none; padding: 0; margin: 0; }
.srb-result-item {
    display: grid; grid-template-columns: 26px 1fr;
    gap: 10px; padding: 16px 0;
    border-bottom: 1px solid var(--srb-borderl);
}
.srb-result-item:last-child { border-bottom: none; }
.srb-ri-num { text-align: right; font-size: .875rem; color: var(--srb-t3); padding-top: 2px; font-variant-numeric: tabular-nums; }
.srb-ri-body { min-width: 0; }
.srb-ri-top { display: flex; align-items: center; gap: 7px; margin-bottom: 4px; flex-wrap: wrap; }
.srb-ri-title {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 1rem; color: var(--srb-accent); text-decoration: none;
    display: block; line-height: 1.45; margin-bottom: 2px;
}
.srb-ri-title:hover { color: var(--srb-accent2); text-decoration: underline; text-decoration-skip-ink: auto; }
.srb-ri-author { font-size: .875rem; color: var(--srb-green); margin: 2px 0 0; }
.srb-ri-biblio { font-size: .82rem; color: var(--srb-t2); margin: 2px 0 0; }
.srb-ri-abstract { font-size: .875rem; color: var(--srb-t2); line-height: 1.55; margin: 0; }
.srb-ri-year { font-size: .8rem; color: var(--srb-t3); font-variant-numeric: tabular-nums; }

/* ── Badges ── */
.srb-badge {
    display: inline-flex; padding: 1px 7px; border-radius: 4px;
    font-size: .7rem; font-weight: 700;
}
.srb-badge-article     { background: #e8f0fb; color: #1b4fa8; }
.srb-badge-preprint    { background: #f3f0ff; color: #6d28d9; }
.srb-badge-book        { background: #fef3c7; color: #b45309; }
.srb-badge-incollection{ background: #e0f7fa; color: #0e7490; }
.srb-badge-inproceedings{background: #e0f7fa; color: #0e7490; }
.srb-badge-proceedings { background: #fce7f3; color: #be185d; }
.srb-badge-thesis      { background: #fff4ee; color: #9a3412; }
.srb-badge-misc        { background: #f0f0f0; color: #666; }

/* ── DataTable list styles (same as home) ── */
#searchTable_wrapper { font-size: .9375rem; }
#searchTable_wrapper .dataTables_length,
#searchTable_wrapper .dataTables_info { font-size: .82rem; color: var(--srb-t3); }
#searchTable_wrapper .dataTables_length select {
    padding: 3px 8px; border: 1px solid var(--srb-border);
    border-radius: 6px; background: #fafafa; color: var(--srb-t1);
    font-size: .82rem; outline: none; margin: 0 4px;
}
#searchTable_wrapper .dataTables_paginate { font-size: .875rem; }
#searchTable_wrapper .dataTables_paginate .paginate_button {
    border-radius: 5px !important; border: 1px solid var(--srb-border) !important;
    color: var(--srb-t2) !important; margin: 0 1px !important; padding: 2px 8px !important;
}
#searchTable_wrapper .dataTables_paginate .paginate_button.current {
    background: var(--srb-accent) !important; border-color: var(--srb-accent) !important;
    color: #fff !important; font-weight: 600 !important;
}
#searchTable_wrapper .dataTables_paginate .paginate_button:not(.disabled):hover {
    background: var(--srb-accbg) !important; border-color: var(--srb-accent) !important;
    color: var(--srb-accent) !important;
}
table#searchTable { border: none !important; }
table#searchTable thead { display: none; }
table#searchTable tbody tr { border-bottom: 1px solid var(--srb-borderl) !important; }
table#searchTable tbody tr:last-child { border-bottom: none !important; }
table#searchTable tbody td { padding: 14px 0 !important; border: none !important; vertical-align: top; }
.ri-wrap { display: flex; gap: 10px; }

/* ── Empty state ── */
.srb-empty {
    text-align: center; padding: 48px 20px;
    color: var(--srb-t3); font-size: .9375rem;
}
.srb-empty-icon { font-size: 2rem; margin-bottom: 10px; }
</style>
{% endblock %}

{% block body %}
{% set qtype = app.request.query.get('type', 'all') %}
{% set qallYears = app.request.query.get('allYears', '') %}

<div class="srb-page">

    <header class="srb-page-header">
        <h1 class="srb-page-title">Búsqueda avanzada</h1>
        <p class="srb-page-desc">Filtra por título, autor, tipo de publicación, resumen y rango de años.</p>
    </header>

    {# ── Form ── #}
    <form method="GET" action="{{ path('app_search') }}" class="srb-form-panel" id="searchForm">

        <div class="srb-form-row-2">
            <div class="srb-field">
                <label for="s_title">Título</label>
                <input type="text" id="s_title" name="title"
                       value="{{ app.request.query.get('title', '') }}"
                       placeholder="El título contiene…" autocomplete="off">
            </div>
            <div class="srb-field">
                <label for="s_author">Autor</label>
                <input type="text" id="s_author" name="author"
                       value="{{ app.request.query.get('author', '') }}"
                       placeholder="Nombre del autor contiene…" autocomplete="off">
            </div>
        </div>

        <div class="srb-form-row-1">
            <div class="srb-field">
                <label for="s_keyword">Palabra clave / Resumen</label>
                <input type="text" id="s_keyword" name="keyword"
                       value="{{ app.request.query.get('keyword', '') }}"
                       placeholder="Buscar en resumen o palabras clave…" autocomplete="off">
            </div>
        </div>

        {# ── Type chips ── #}
        <div class="srb-chips-row">
            <label style="font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--srb-t3);">
                Tipo de publicación
            </label>
            <div class="srb-chips" id="typeChips">
                {% set typeMap = {
                    'all':           'All',
                    'article':       'Article',
                    'preprint':      'Preprint',
                    'book':          'Book',
                    'incollection':  'Incollection',
                    'inproceedings': 'Inproceedings',
                    'proceedings':   'Proceedings',
                    'thesis':        'Thesis',
                    'misc':          'Misc'
                } %}
                {% for val, label in typeMap %}
                <label class="srb-chip {% if qtype == val %}chip-active{% endif %}">
                    <input type="radio" name="type" value="{{ val }}"
                           {{ qtype == val ? 'checked' : '' }}>
                    {{ label }}
                </label>
                {% endfor %}
            </div>
        </div>

        {# ── Year range ── #}
        <div class="srb-year-row {% if qallYears %}years-disabled{% endif %}" id="yearRow">
            <div class="srb-year-field">
                <label for="s_yearStart">Año desde</label>
                <input type="number" id="s_yearStart" name="yearStart"
                       value="{{ app.request.query.get('yearStart', '') }}"
                       min="1990" max="{{ 'now'|date('Y') }}" placeholder="1990">
            </div>
            <span class="srb-year-sep">—</span>
            <div class="srb-year-field">
                <label for="s_yearEnd">Año hasta</label>
                <input type="number" id="s_yearEnd" name="yearEnd"
                       value="{{ app.request.query.get('yearEnd', '') }}"
                       min="1990" max="{{ 'now'|date('Y') }}" placeholder="{{ 'now'|date('Y') }}">
            </div>
            <div class="srb-toggle-wrap">
                <label class="srb-toggle">
                    <input type="checkbox" name="allYears" value="1" id="allYears"
                           {{ qallYears ? 'checked' : '' }}>
                    <span class="srb-toggle-track"></span>
                </label>
                <label for="allYears" class="srb-toggle-label">Todos los años</label>
            </div>
        </div>

        <div class="srb-form-actions">
            <button type="submit" class="srb-submit-btn">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="6.5" cy="6.5" r="5.5"/><path d="M11 11l3 3"/>
                </svg>
                Buscar
            </button>
            <a href="{{ path('app_search') }}" class="srb-reset-link">Limpiar filtros</a>
        </div>

    </form>

    {# ── Results (DataTable AJAX, only when criteria present) ── #}
    <div id="resultsSection" style="display:none;">
        <div class="srb-section-head" style="margin-bottom:2px;"></div>
        <table id="searchTable" style="width:100%">
            <thead><tr><th></th><th></th><th></th><th></th></tr></thead>
        </table>
    </div>

    <div id="emptySection" style="display:none;">
        <div class="srb-empty">
            <div class="srb-empty-icon">∅</div>
            <p>No se encontraron referencias con los criterios indicados.</p>
            <a href="{{ path('app_search') }}" style="color:var(--srb-accent);font-size:.82rem;">Limpiar filtros</a>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    /* ── Chip active state ── */
    document.querySelectorAll('#typeChips .srb-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            document.querySelectorAll('#typeChips .srb-chip').forEach(c => c.classList.remove('chip-active'));
            chip.classList.add('chip-active');
        });
    });

    /* ── All-years toggle ── */
    const toggle = document.getElementById('allYears');
    const yearRow = document.getElementById('yearRow');
    if (toggle) {
        toggle.addEventListener('change', () => {
            yearRow.classList.toggle('years-disabled', toggle.checked);
        });
    }

    /* ── DataTable with AJAX ── */
    const params = new URLSearchParams(window.location.search);
    const hasCriteria = params.has('type') ||
        ['title','author','keyword','yearStart','yearEnd','allYears']
            .some(k => params.get(k) && params.get(k) !== '');

    if (!hasCriteria) return;

    document.getElementById('resultsSection').style.display = 'block';

    const criteria = {};
    if (params.get('title'))    criteria.title    = params.get('title');
    if (params.get('author'))   criteria.author   = params.get('author');
    if (params.get('keyword'))  criteria.keyword  = params.get('keyword');
    if (params.get('type') && params.get('type') !== 'all') criteria.type = params.get('type');
    if (params.get('yearStart')) criteria.yearStart = params.get('yearStart');
    if (params.get('yearEnd'))   criteria.yearEnd   = params.get('yearEnd');
    if (params.get('allYears'))  criteria.allYears  = true;

    const BADGE = {
        article:       ['srb-badge-article',      'Article'],
        preprint:      ['srb-badge-preprint',      'Preprint'],
        book:          ['srb-badge-book',          'Book'],
        incollection:  ['srb-badge-incollection',  'Incollection'],
        inproceedings: ['srb-badge-inproceedings', 'Inproceedings'],
        proceedings:   ['srb-badge-proceedings',   'Proceedings'],
        thesis:        ['srb-badge-thesis',        'Thesis'],
        misc:          ['srb-badge-misc',          'Misc'],
    };

    function badge(type) {
        const t = (type || '').toLowerCase();
        const [cls, label] = BADGE[t] || ['srb-badge-misc', type || '—'];
        return `<span class="srb-badge ${cls}">${label}</span>`;
    }

    function biblio(row) {
        const t = (row.type || '').toLowerCase();
        const parts = [];
        if (t === 'article') {
            if (row.journal)   parts.push(`<em>${row.journal}</em>`);
            if (row.volume)    parts.push(`Vol. ${row.volume}`);
            if (row.issue)     parts.push(`Issue ${row.issue}`);
            if (row.year)      parts.push(row.year);
            if (row.pages)     parts.push(`p. ${row.pages}`);
        } else if (t === 'book') {
            if (row.publisher) parts.push(row.publisher);
            if (row.placePub)  parts.push(row.placePub);
            if (row.year)      parts.push(row.year);
        } else if (t === 'inproceedings' || t === 'proceedings') {
            if (row.bookTitle) parts.push(`<em>${row.bookTitle}</em>`);
            if (row.publisher) parts.push(row.publisher);
            if (row.year)      parts.push(row.year);
            if (row.pages)     parts.push(`p. ${row.pages}`);
        } else if (t === 'incollection') {
            if (row.bookTitle) parts.push(`<em>${row.bookTitle}</em>`);
            if (row.editor)    parts.push(`Ed. ${row.editor}`);
            if (row.publisher) parts.push(row.publisher);
            if (row.year)      parts.push(row.year);
            if (row.pages)     parts.push(`p. ${row.pages}`);
        } else if (t === 'thesis') {
            if (row.school)    parts.push(row.school);
            if (row.year)      parts.push(row.year);
        } else {
            if (row.year)      parts.push(row.year);
        }
        return parts.length ? `<p class="srb-ri-biblio">${parts.join(', ')}</p>` : '';
    }

    const dt = $('#searchTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '{{ path('app_reference_data') }}',
            type: 'GET',
            data: d => { d.criteria = JSON.stringify(criteria); },
        },
        columns: [
            {
                data: 'title',
                render: (d, t, row, meta) => {
                    const n = meta.row + meta.settings._iDisplayStart + 1;
                    const bib  = biblio(row);
                    const auth = row.author ? `<p class="srb-ri-author">${row.author}</p>` : '';
                    return `<div class="ri-wrap">
                        <span class="srb-ri-num">${n}.</span>
                        <div class="srb-ri-body">
                            <div class="srb-ri-top">${badge(row.type)}</div>
                            <a href="${row.url_show}" class="srb-ri-title">${d}</a>
                            ${bib}
                            ${auth}
                        </div>
                    </div>`;
                }
            },
            { data: 'author',    visible: false },
            { data: 'type',      visible: false },
            { data: 'year',      visible: false },
            { data: 'journal',   visible: false },
            { data: 'volume',    visible: false },
            { data: 'issue',     visible: false },
            { data: 'pages',     visible: false },
            { data: 'publisher', visible: false },
            { data: 'placePub',  visible: false },
            { data: 'bookTitle', visible: false },
            { data: 'editor',    visible: false },
            { data: 'school',    visible: false },
        ],
        order: [[3, 'desc']],
        pageLength: 10,
        dom: '<"d-flex justify-content-between align-items-center mb-2"li>t<"d-flex justify-content-between align-items-center mt-2"p>',
        language: {
            lengthMenu: 'Mostrar _MENU_',
            info: '_START_–_END_ de _TOTAL_ referencias',
            infoEmpty: 'Sin registros',
            zeroRecords: 'Sin resultados para los criterios indicados.',
            paginate: { first: '«', last: '»', next: '›', previous: '‹' },
            processing: 'Cargando…',
        },
    });

    /* Show empty section if 0 results after first draw */
    dt.on('draw', () => {
        const info = dt.page.info();
        document.getElementById('emptySection').style.display =
            (info.recordsDisplay === 0) ? 'block' : 'none';
    });

})();
</script>
{% endblock %}
