{% extends 'base.html.twig' %}

{% block title %}Referencias — SRB CCM UNAM{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap">
<style>
:root {
    --srb-bg:      #ffffff;
    --srb-surf:    #ffffff;
    --srb-surf2:   #f6f7f8;
    --srb-border:  #e0e2e6;
    --srb-borderl: #eceef1;
    --srb-t1:      #1a1a1a;
    --srb-t2:      #555555;
    --srb-t3:      #999999;
    --srb-accent:  #1b4fa8;
    --srb-accent2: #144090;
    --srb-accbg:   #e8f0fb;
    --srb-green:   #1a6e46;
}

body { background: var(--srb-bg); font-family: 'Source Sans 3', system-ui, sans-serif; }
.srb-page { max-width: 1080px; margin: 0 auto; padding: 0 20px 60px; }

/* ── Page header ── */
.srb-page-header {
    padding: 24px 0 20px;
    border-bottom: 1px solid var(--srb-border);
    margin-bottom: 20px;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
}
.srb-page-title {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 1.5rem; font-weight: 700; color: var(--srb-t1);
}
.srb-page-action {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 7px 16px; background: var(--srb-accent); color: #fff;
    border-radius: 7px; font-size: .9rem; font-weight: 500;
    text-decoration: none;
}
.srb-page-action:hover { background: var(--srb-accent2); color: #fff; }

/* ── DataTable overrides ── */
#refsTable_wrapper { font-size: .9375rem; }
#refsTable_wrapper .dataTables_length,
#refsTable_wrapper .dataTables_filter { font-size: .82rem; color: var(--srb-t3); }
#refsTable_wrapper .dataTables_filter input {
    padding: 4px 10px;
    border: 1px solid var(--srb-border);
    border-radius: 6px;
    background: var(--srb-surf2);
    color: var(--srb-t1);
    font-size: .82rem;
    outline: none;
    margin-left: 4px;
}
#refsTable_wrapper .dataTables_filter input:focus {
    border-color: var(--srb-accent);
    box-shadow: 0 0 0 2px var(--srb-accbg);
}
#refsTable_wrapper .dataTables_info { font-size: .8rem; color: var(--srb-t3); }
#refsTable_wrapper .dataTables_paginate { font-size: .875rem; }
#refsTable_wrapper .dataTables_paginate .paginate_button {
    border-radius: 5px !important; border: 1px solid var(--srb-border) !important;
    color: var(--srb-t2) !important; margin: 0 1px !important;
    padding: 2px 8px !important;
}
#refsTable_wrapper .dataTables_paginate .paginate_button.current {
    background: var(--srb-accent) !important;
    border-color: var(--srb-accent) !important;
    color: #fff !important; font-weight: 600 !important;
}
#refsTable_wrapper .dataTables_paginate .paginate_button:not(.disabled):hover {
    background: var(--srb-accbg) !important;
    border-color: var(--srb-accent) !important;
    color: var(--srb-accent) !important;
}
table#refsTable { border: none !important; }
table#refsTable thead { display: none; }
table#refsTable tbody tr { border-bottom: 1px solid var(--srb-borderl) !important; }
table#refsTable tbody tr:last-child { border-bottom: none !important; }
table#refsTable tbody td {
    padding: 14px 0 !important;
    border: none !important;
    vertical-align: top;
}

/* ── Reference item ── */
.ri-wrap { display: flex; gap: 10px; }
.ri-num { min-width: 32px; text-align: right; font-size: .875rem; color: var(--srb-t3); padding-top: 2px; font-variant-numeric: tabular-nums; }
.ri-body { flex: 1; min-width: 0; }
.ri-top { display: flex; align-items: center; gap: 7px; margin-bottom: 4px; flex-wrap: wrap; }
.ri-title {
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 1rem; color: var(--srb-accent);
    text-decoration: none; display: block; line-height: 1.45; margin-bottom: 2px;
}
.ri-title:hover { color: var(--srb-accent2); text-decoration: underline; }
.ri-author { font-size: .875rem; color: var(--srb-green); margin: 2px 0 0; }
.ri-biblio { font-size: .82rem; color: var(--srb-t2); margin: 2px 0 0; }
.ri-year { font-size: .8rem; color: var(--srb-t3); font-variant-numeric: tabular-nums; }

/* ── Badges ── */
.ri-badge {
    display: inline-flex; align-items: center;
    padding: 1px 7px; border-radius: 4px;
    font-size: .7rem; font-weight: 700;
    white-space: nowrap;
}
.ri-badge-article      { background: #e8f0fb; color: #1b4fa8; }
.ri-badge-preprint     { background: #f3f0ff; color: #6d28d9; }
.ri-badge-book         { background: #fef3c7; color: #b45309; }
.ri-badge-chapter      { background: #e0f7fa; color: #0e7490; }
.ri-badge-incollection { background: #e0f7fa; color: #0e7490; }
.ri-badge-inproceedings{ background: #ecfdf5; color: #065f46; }
.ri-badge-proceedings  { background: #fce7f3; color: #be185d; }
.ri-badge-thesis       { background: #fff4ee; color: #9a3412; }
.ri-badge-default      { background: #f0f0f0; color: #555; }
</style>
{% endblock %}

{% block body %}
<div class="srb-page">

    <header class="srb-page-header">
        <h1 class="srb-page-title">Sistema de Referencias Bibliográficas</h1>
        {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_reference_new') }}" class="srb-page-action">
            <i class="bi bi-plus-circle"></i> Nueva referencia
        </a>
        {% endif %}
    </header>

    <table id="refsTable" style="width:100%">
        <thead><tr><th></th><th></th><th></th><th></th></tr></thead>
    </table>

</div>
{% endblock %}

{% block javascripts %}
<script>
$(function () {
    const BADGE = {
        article:       ['ri-badge-article',       'Article'],
        preprint:      ['ri-badge-preprint',       'Preprint'],
        book:          ['ri-badge-book',           'Book'],
        chapter:       ['ri-badge-chapter',        'Chapter'],
        incollection:  ['ri-badge-incollection',   'Incollection'],
        inproceedings: ['ri-badge-inproceedings',  'Inproceedings'],
        proceedings:   ['ri-badge-proceedings',    'Proceedings'],
        thesis:        ['ri-badge-thesis',         'Thesis'],
    };

    function badge(type) {
        const t = (type || '').toLowerCase();
        const [cls, label] = BADGE[t] || ['ri-badge-default', type || '—'];
        return `<span class="ri-badge ${cls}">${label}</span>`;
    }

    function biblio(row) {
        const t = (row.type || '').toLowerCase();
        const parts = [];
        if (t === 'article') {
            if (row.journal)   parts.push(`<em>${row.journal}</em>`);
            if (row.volume)    parts.push(`Vol. ${row.volume}`);
            if (row.issue)     parts.push(`Issue ${row.issue}`);
            if (row.year)      parts.push(row.year);
            if (row.pages)     parts.push(`p. ${row.pages}`);
        } else if (t === 'book') {
            if (row.publisher) parts.push(row.publisher);
            if (row.placePub)  parts.push(row.placePub);
            if (row.year)      parts.push(row.year);
        } else if (t === 'inproceedings' || t === 'proceedings') {
            if (row.bookTitle) parts.push(`<em>${row.bookTitle}</em>`);
            if (row.publisher) parts.push(row.publisher);
            if (row.year)      parts.push(row.year);
            if (row.pages)     parts.push(`p. ${row.pages}`);
        } else if (t === 'incollection') {
            if (row.bookTitle) parts.push(`<em>${row.bookTitle}</em>`);
            if (row.editor)    parts.push(`Ed. ${row.editor}`);
            if (row.publisher) parts.push(row.publisher);
            if (row.year)      parts.push(row.year);
            if (row.pages)     parts.push(`p. ${row.pages}`);
        } else if (t === 'thesis') {
            if (row.school)    parts.push(row.school);
            if (row.year)      parts.push(row.year);
        } else {
            if (row.year)      parts.push(row.year);
        }
        return parts.length ? `<p class="ri-biblio">${parts.join(', ')}</p>` : '';
    }

    $('#refsTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: { url: '{{ path('app_reference_data') }}', type: 'GET' },
        columns: [
            {
                data: 'title',
                render: (d, t, row, meta) => {
                    const n = meta.row + meta.settings._iDisplayStart + 1;
                    const bib    = biblio(row);
                    const author = row.author ? `<p class="ri-author">${row.author}</p>` : '';
                    return `<div class="ri-wrap">
                        <span class="ri-num">${n}.</span>
                        <div class="ri-body">
                            <div class="ri-top">${badge(row.type)}</div>
                            <a href="${row.url_show}" class="ri-title">${d}</a>
                            ${bib}
                            ${author}
                        </div>
                    </div>`;
                }
            },
            { data: 'author',    visible: false },
            { data: 'type',      visible: false },
            { data: 'year',      visible: false },
            { data: 'journal',   visible: false },
            { data: 'volume',    visible: false },
            { data: 'issue',     visible: false },
            { data: 'pages',     visible: false },
            { data: 'publisher', visible: false },
            { data: 'placePub',  visible: false },
            { data: 'bookTitle', visible: false },
            { data: 'editor',    visible: false },
            { data: 'school',    visible: false },
        ],
        order: [[3, 'desc']],
        pageLength: 10,
        dom: '<"d-flex justify-content-between align-items-center mb-2"lf>t<"d-flex justify-content-between align-items-center mt-2"ip>',
        language: {
            search: 'Filtrar:',
            lengthMenu: 'Mostrar _MENU_',
            info: '_START_–_END_ de _TOTAL_',
            infoEmpty: 'Sin registros',
            zeroRecords: 'Sin resultados',
            paginate: { first: '«', last: '»', next: '›', previous: '‹' },
            processing: 'Cargando…',
        },
    });
});
</script>
{% endblock %}
